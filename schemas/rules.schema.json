{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://envfingerprint.dev/schemas/rules.schema.json",
  "title": "EnvFingerprint project rules (.envfingerprint.json), schema v1",
  "type": "object",
  "required": ["schema"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "variables": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "uniqueItems": true
        },
        "compareValues": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "uniqueItems": true
        },
        "sensitivePatterns": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
          "minVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$" }
        }
      }
    },
    "files": {
      "type": "array",
      "items": { "type": "string", "not": { "pattern": "^(/|[A-Za-z]:|.*\\.\\.)" } },
      "uniqueItems": true
    },
    "fileDigests": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "compare": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sections": {
          "type": "array",
          "items": { "enum": ["environment", "runtimes", "files", "variables"] },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "expectedFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
