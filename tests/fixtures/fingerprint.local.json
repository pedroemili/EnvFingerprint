{
  "schema": 1,
  "tool": { "name": "envfingerprint", "version": "0.1.0" },
  "environment": {
    "profile": "local",
    "os": "darwin",
    "arch": "arm64",
    "container": false,
    "ci": false
  },
  "runtimes": [
    { "name": "go", "version": "1.23.2" },
    { "name": "node", "version": "20.11.0" },
    { "name": "python", "version": "3.12.1" }
  ],
  "files": [
    { "path": "go.mod", "kind": "config", "present": true },
    { "path": "go.sum", "kind": "lockfile", "present": true, "digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }
  ],
  "variables": [
    { "key": "CFG_MODE", "state": "present", "sensitive": false, "compare": "value", "value": "development" },
    { "key": "DATABASE_URL", "state": "present", "sensitive": true, "compare": "presence" }
  ],
  "experimental_field": { "not": "part of the contract" },
  "meta": { "hashAlgorithm": "sha256-canonical-json-v1" },
  "fingerprint": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
}
